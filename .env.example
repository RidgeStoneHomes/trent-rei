# Postgres. On Vercel these are added automatically when you connect Neon under Storage.
DATABASE_URL="postgresql://user:password@localhost:5432/reynolds"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/reynolds"

# Public URL of the site (used in emails, QR codes, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string used to sign guest + admin session cookies
SESSION_SECRET="change-me-to-a-long-random-string"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Stripe. Leave blank to run without payments: local dev confirms bookings for free;
# a live site shows "contact us to book" unless ALLOW_DEMO_PAYMENTS="true" (preview only!)
STRIPE_SECRET_KEY=""
ALLOW_DEMO_PAYMENTS=""
STRIPE_WEBHOOK_SECRET=""

# Email via Resend (leave blank to log emails to the console)
RESEND_API_KEY=""
EMAIL_FROM="Reynolds Retreats <stay@example.com>"
HOST_NOTIFY_EMAIL=""

# Channel calendar export (iCal) URLs, so direct bookings never double-book.
# Comma-separate several feeds: OwnerRez, VRBO, Airbnb, Furnished Finder...
# One variable per property: ICAL_IMPORT_<SLUG uppercased, dashes -> underscores>
ICAL_IMPORT_THE_OVERLOOK=""
ICAL_IMPORT_IRONWOOD_ACRES=""
